PORT=3000
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Opcional: CA de OpenSearch en una sola línea con \n (solo si falla el certificado)
OPENSEARCH_CA=
OPENSEARCH_INDEX=users
KAFKA_BROKERS=
KAFKA_SSL=true
KAFKA_SSL_CA=
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Tópicos separados por coma. Users publica en users.created, users.updated y users.deleted
KAFKA_TOPIC_USER_EVENTS=users.created,users.updated,users.deleted
KAFKA_GROUP_ID=search-service
KAFKA_FROM_BEGINNING=true
# Mismo secreto que users-management, en Base64
JWT_SECRET=
# Roles con acceso a la búsqueda, separados por coma
SEARCH_ALLOWED_ROLES=ADMIN,REVIEWER
