{
  "name": "search-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx scripts/worker.ts",
    "start:all": "concurrently -n web,worker -c blue,green --kill-others \"npm run start\" \"npm run worker\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "concurrently": "^10.0.7",
    "jose": "^6.2.17",
    "kafkajs": "^2.2.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
